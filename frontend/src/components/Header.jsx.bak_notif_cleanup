import React, { useState, useRef, useEffect, useMemo } from 'react';
import { 
  Menu, 
  Search, 
  Bell, 
  CheckCircle2, 
  ChevronDown, 
  Clock, 
  SlidersHorizontal,
  ExternalLink,
  X,
  Folder,
  Users,
  CheckSquare,
  FileBarChart,
  Calendar as CalendarIcon,
  LayoutDashboard,
  Settings as SettingsIcon,
  ArrowRight,
  LogOut,
  UserCheck,
  Target,
  Briefcase,
  AlertCircle,
  ShieldAlert
} from 'lucide-react';
import { USER_PROFILE, DIGIPLUS_TEAM_MEMBERS, INITIAL_PROJECTS } from '../data/mockData';

export default function Header({
  activePage,
  onOpenMobileMenu,
  activeTimer,
  onNavigateToTracker,
  setActivePage,
  projects = INITIAL_PROJECTS,
  activities = [],
  searchQuery = '',
  setSearchQuery = () => {},
  currentUser = null,
  onLogout = null,
  usersList = []
}) {
  const [showNotifications, setShowNotifications] = useState(false);
  const [showProfilePopover, setShowProfilePopover] = useState(false);
  const [readNotifIds, setReadNotifIds] = useState([]);

  const notifContainerRef = useRef(null);
  const profileContainerRef = useRef(null);
  const searchContainerRef = useRef(null);
  const searchInputRef = useRef(null);

  // Keyboard shortcut Ctrl+K / Cmd+K to focus search
  useEffect(() => {
    const handleKeyDown = (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        searchInputRef.current?.focus();
      }
      if (e.key === 'Escape') {
        setSearchQuery('');
        searchInputRef.current?.blur();
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [setSearchQuery]);

  // Close popovers on outside click
  useEffect(() => {
    function handleClickOutside(event) {
      if (notifContainerRef.current && !notifContainerRef.current.contains(event.target)) {
        setShowNotifications(false);
      }
      if (profileContainerRef.current && !profileContainerRef.current.contains(event.target)) {
        setShowProfilePopover(false);
      }
    }
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  // All available system pages for search
  const SYSTEM_PAGES = [
    { id: 'reports', label: 'Time Reports', desc: 'Detailed summaries & exports', icon: FileBarChart },
    { id: 'projects', label: 'Projects Directory', desc: 'Project budgets & clients', icon: Folder },
    { id: 'time-tracker', label: 'Time Tracker', desc: 'Live timer & manual logging', icon: Clock },
    { id: 'timesheet', label: 'Timesheet', desc: 'Day-by-day hours grid', icon: CheckSquare },
    { id: 'dashboard', label: 'Analytics Dashboard', desc: 'Metrics & workspace activity', icon: LayoutDashboard },
    { id: 'team', label: 'Team Members', desc: 'Employee roles & departments', icon: Users },
    { id: 'calendar', label: 'Activity Calendar', desc: 'Schedule timeline view', icon: CalendarIcon },
    { id: 'settings', label: 'Workspace Settings', desc: 'Preferences & alerts', icon: SettingsIcon },
  ];

  // Dynamic search results
  const searchResults = useMemo(() => {
    const q = searchQuery.trim().toLowerCase();
    if (!q) return { pages: [], projects: [], team: [], tasks: [], total: 0 };

    const matchedPages = SYSTEM_PAGES.filter(p => 
      p.label.toLowerCase().includes(q) || p.desc.toLowerCase().includes(q) || p.id.toLowerCase().includes(q)
    );

    const matchedProjects = projects.filter(p => 
      p.name.toLowerCase().includes(q) || (p.client && p.client.toLowerCase().includes(q))
    ).slice(0, 5);

    const list = usersList && usersList.length > 0 ? usersList : [
      { id: 'usr-admin-1', name: 'Bharath (Owner)', role: 'Owner', group: 'Management / Executive' }
    ];
    const matchedTeam = list.filter(m => 
      (m.name && m.name.toLowerCase().includes(q)) || 
      (m.department && m.department.toLowerCase().includes(q)) || 
      (m.group && m.group.toLowerCase().includes(q)) || 
      (m.role && m.role.toLowerCase().includes(q))
    ).slice(0, 4);

    const matchedTasks = activities.filter(a => 
      (a.description && a.description.toLowerCase().includes(q)) || (a.project && a.project.toLowerCase().includes(q))
    ).slice(0, 4);

    const total = matchedPages.length + matchedProjects.length + matchedTeam.length + matchedTasks.length;
    return { pages: matchedPages, projects: matchedProjects, team: matchedTeam, tasks: matchedTasks, total };
  }, [searchQuery, projects, activities, usersList]);

  // Dynamically compute avatar initials from whatever name is configured
  const getInitials = (name) => {
    if (!name) return 'DA';
    const words = name.trim().split(/\s+/).filter(Boolean);
    if (words.length === 1) return words[0].substring(0, 2).toUpperCase();
    return (words[0][0] + words[words.length - 1][0]).toUpperCase();
  };

  const userInitials = getInitials(USER_PROFILE.name);

  const getPageMeta = () => {
    switch (activePage) {
      case 'dashboard':
        return {
          title: 'Analytics Dashboard',
          subtitle: 'Workspace performance overview, project distribution, and top tracked activities',
        };
      case 'reports':
        return {
          title: 'Time Reports',
          subtitle: 'Detailed time summaries, project billability, and exportable logs',
        };
      case 'projects':
        return {
          title: 'Projects Directory',
          subtitle: 'Manage client deliverables, hourly budgets, and public/private accessibility',
        };
      case 'team':
        return {
          title: 'Team Members',
          subtitle: 'DigiPlus workspace staff, role permissions, and department group assignments',
        };
      case 'time-tracker':
        return {
          title: 'Time Tracker',
          subtitle: 'Monitor working sessions, log billable hours, and analyze focus time',
        };
      case 'timesheet':
        return {
          title: 'Project Timesheet',
          subtitle: 'Weekly day-by-day hours breakdown, project allocations, and approvals',
        };
      case 'calendar':
        return {
          title: 'Activity Calendar',
          subtitle: 'Weekly schedule timeline and monthly task distribution',
        };
      case 'settings':
        return {
          title: 'Workspace Settings',
          subtitle: 'Configure your profile, notification rules, and tracking preferences',
        };
      default:
        return {
          title: 'Dashboard',
          subtitle: 'Welcome back to DigiPlus Logistics',
        };
    }
  };

  const meta = getPageMeta();

  // Role-based dynamic notification calculation
  const isAdmin = currentUser?.role === 'admin' || (currentUser?.name && currentUser.name.toLowerCase().includes('owner'));

  // Pending users calculation for Admin
  const pendingUsers = useMemo(() => {
    if (!isAdmin) return [];
    return (usersList || []).filter(u => {
      if (!u) return false;
      if (u.role === 'admin' || (u.name && u.name.toLowerCase().includes('owner'))) return false;
      const isApproved = u.active === true || u.active === 1 || u.accessGranted === true || u.access_approved === 1 || u.access_approved === true || u.status === 'active' || u.status === 'Active';
      return !isApproved;
    });
  }, [isAdmin, usersList]);

  const dynamicNotifications = useMemo(() => {
    if (isAdmin) {
      const pendingNotifs = pendingUsers.map(u => ({
        id: 'pending-' + (u.id || u.email || u.name),
        title: 'Access Request: ' + u.name,
        message: u.name + ' (' + (u.department || u.role || 'Employee') + ') requested workspace access. Click to grant access in Team page.',
        time: 'Action Required',
        tag: 'Access Request',
        tagBg: '#fef3c7',
        tagColor: '#b45309',
        isPendingAccess: true,
        targetPage: 'team',
        unread: !readNotifIds.includes('pending-' + (u.id || u.email || u.name))
      }));

      const adminNotifs = [
        {
          id: 'adm-notif-1',
          title: 'Timesheet Submissions Received',
          message: 'Active team members have submitted this week\'s timesheets for review.',
          time: '15m ago',
          tag: 'Timesheets',
          tagBg: '#eff6ff',
          tagColor: '#1d4ed8',
          targetPage: 'reports',
          unread: !readNotifIds.includes('adm-notif-1')
        },
        {
          id: 'adm-notif-2',
          title: 'JRKS Logistics - 85% Budget',
          message: 'Project reached 85% of allocated hours (42.5h / 50h).',
          time: '1h ago',
          tag: 'Milestone',
          tagBg: '#ecfdf5',
          tagColor: '#047857',
          targetPage: 'projects',
          unread: !readNotifIds.includes('adm-notif-2')
        },
        {
          id: 'adm-notif-3',
          title: 'Weekly Workspace Target Met',
          message: 'Total team weekly target of 160h achieved (102.5%).',
          time: 'Yesterday',
          tag: 'Performance',
          tagBg: '#f5f3ff',
          tagColor: '#6d28d9',
          targetPage: 'dashboard',
          unread: !readNotifIds.includes('adm-notif-3')
        }
      ];

      return [...pendingNotifs, ...adminNotifs];
    } else {
      // Employee notifications
      return [
        {
          id: 'emp-notif-1',
          title: 'Timesheet Approved ✓',
          message: 'Your weekly timesheet has been approved by Bharath (Admin).',
          time: '30m ago',
          tag: 'Approved',
          tagBg: '#ecfdf5',
          tagColor: '#047857',
          targetPage: 'timesheet',
          unread: !readNotifIds.includes('emp-notif-1')
        },
        {
          id: 'emp-notif-2',
          title: 'Weekly Hours Target (32.5 / 40h)',
          message: 'You have completed 32.5 hours this week. 7.5 hours remaining to hit goal.',
          time: '2h ago',
          tag: 'Target Progress',
          tagBg: '#eff6ff',
          tagColor: '#1d4ed8',
          targetPage: 'time-tracker',
          unread: !readNotifIds.includes('emp-notif-2')
        },
        {
          id: 'emp-notif-3',
          title: 'Assigned to JRKS Logistics',
          message: 'You are allocated as active contributor on JRKS Logistics.',
          time: 'Yesterday',
          tag: 'Assignment',
          tagBg: '#fef3c7',
          tagColor: '#b45309',
          targetPage: 'projects',
          unread: !readNotifIds.includes('emp-notif-3')
        },
        {
          id: 'emp-notif-4',
          title: 'Daily Shift Log Reminder',
          message: 'Remember to submit your active task timers before end of shift.',
          time: '1d ago',
          tag: 'Reminder',
          tagBg: '#f3f4f6',
          tagColor: '#4b5563',
          targetPage: 'time-tracker',
          unread: !readNotifIds.includes('emp-notif-4')
        }
      ];
    }
  }, [isAdmin, pendingUsers, readNotifIds, currentUser]);

  const unreadCount = useMemo(() => {
    return dynamicNotifications.filter(n => n.unread).length;
  }, [dynamicNotifications]);

  const markAllRead = () => {
    const allIds = dynamicNotifications.map(n => n.id);
    setReadNotifIds(prev => Array.from(new Set([...prev, ...allIds])));
  };

  const handleNotificationClick = (n) => {
    setReadNotifIds(prev => Array.from(new Set([...prev, n.id])));
    if (n.targetPage && setActivePage) {
      setActivePage(n.targetPage);
    }
    setShowNotifications(false);
  };

  const formatTimerSeconds = (sec) => {
    const hrs = Math.floor(sec / 3600);
    const mins = Math.floor((sec % 3600) / 60);
    const secs = sec % 60;
    return `${String(hrs).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  };

  return (
    <header className="top-header">
      {/* Left side: Hamburger button + Title */}
      <div className="header-left">
        <button 
          className="mobile-menu-btn" 
          onClick={onOpenMobileMenu}
          aria-label="Open navigation menu"
        >
          <Menu size={18} />
        </button>

        <div className="page-titles">
          <h1 className="page-title">{meta.title}</h1>
          <span className="page-subtitle">{meta.subtitle}</span>
        </div>
      </div>

      {/* Right side: Search, Live Timer Pill, Notifications, User */}
      <div className="header-right">
        {/* Live Timer Pill */}
        {activeTimer && activeTimer.isRunning && (
          <div 
            className="header-live-timer" 
            onClick={onNavigateToTracker}
            title="Timer is active! Click to jump to tracker"
          >
            <span className="pulse-dot"></span>
            <span className="header-live-timer-text">
              {formatTimerSeconds(activeTimer.elapsedSeconds)}
            </span>
            <span style={{ color: '#94a3b8', fontSize: '11px' }}>
              • {activeTimer.projectName || 'Tracking'}
            </span>
          </div>
        )}

        {/* In-Page Live Search & Filter Bar */}
        <div className="search-container" ref={searchContainerRef}>
          <Search size={15} className="search-icon" />
          <input
            ref={searchInputRef}
            type="text"
            className="search-input"
            placeholder="Search projects, tasks, or entries..."
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
          />
          {searchQuery && (
            <button 
              type="button" 
              className="search-clear-btn"
              onClick={() => {
                setSearchQuery('');
                searchInputRef.current?.focus();
              }}
              title="Clear filter"
            >
              <X size={13} />
            </button>
          )}
        </div>

        {/* Notification Bell */}
        <div style={{ position: 'relative' }} ref={notifContainerRef}>
          <button 
            className="header-btn" 
            onClick={() => setShowNotifications(!showNotifications)}
            title={pendingUsers.length > 0 ? `${pendingUsers.length} pending access request(s)` : "Notifications"}
            aria-label="Notifications"
            style={{ position: 'relative' }}
          >
            <Bell size={17} />
            {unreadCount > 0 && (
              <span 
                className="header-btn-badge"
                style={{
                  backgroundColor: pendingUsers.length > 0 ? '#f59e0b' : 'var(--digi-neon)',
                  boxShadow: pendingUsers.length > 0 ? '0 0 8px #f59e0b' : '0 0 6px var(--digi-neon)',
                  width: pendingUsers.length > 0 ? '8px' : '7px',
                  height: pendingUsers.length > 0 ? '8px' : '7px'
                }}
              />
            )}
          </button>

          {showNotifications && (
            <div className="notif-popover">
              <div className="notif-header">
                <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
                  <span className="notif-title">Notifications</span>
                  {unreadCount > 0 && (
                    <span className="notif-badge-count">{unreadCount} new</span>
                  )}
                </div>
                <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
                  {unreadCount > 0 && (
                    <button type="button" className="notif-mark-read" onClick={markAllRead}>
                      Mark read
                    </button>
                  )}
                  <button 
                    type="button" 
                    className="notif-close-btn" 
                    onClick={() => setShowNotifications(false)}
                    title="Close notifications"
                  >
                    <X size={15} />
                  </button>
                </div>
              </div>

              <div style={{ 
                padding: '7px 14px', 
                backgroundColor: isAdmin ? '#0f172a' : '#1e293b', 
                borderBottom: '1px solid rgba(255, 255, 255, 0.08)',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'space-between'
              }}>
                <span style={{ fontSize: '11px', color: '#94a3b8', fontWeight: 600 }}>
                  {isAdmin ? '👑 Workspace Admin Alerts' : '👤 Employee Activity Feed'}
                </span>
                <span style={{ fontSize: '10px', color: '#38bdf8', fontWeight: 700 }}>
                  {isAdmin ? 'Live Sync' : 'Personal'}
                </span>
              </div>

              {isAdmin && pendingUsers.length > 0 && (
                <div style={{
                  margin: '10px 12px 6px',
                  padding: '9px 12px',
                  backgroundColor: '#fffbeb',
                  border: '1px solid #fde68a',
                  borderRadius: '8px',
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  gap: '8px'
                }}>
                  <div style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>
                    <span style={{ fontSize: '13px' }}>⏳</span>
                    <span style={{ fontSize: '11.5px', color: '#92400e', fontWeight: 700 }}>
                      {pendingUsers.length} Pending Approval{pendingUsers.length > 1 ? 's' : ''}
                    </span>
                  </div>
                  <button
                    type="button"
                    onClick={() => {
                      if (setActivePage) setActivePage('team');
                      setShowNotifications(false);
                    }}
                    style={{
                      fontSize: '11px',
                      fontWeight: 700,
                      color: '#b45309',
                      background: '#fef3c7',
                      border: '1px solid #fcd34d',
                      borderRadius: '4px',
                      padding: '3px 8px',
                      cursor: 'pointer'
                    }}
                  >
                    Review in Team →
                  </button>
                </div>
              )}

              <div className="notif-list">
                {dynamicNotifications.length === 0 ? (
                  <div style={{ padding: '24px 16px', textAlign: 'center', color: '#64748b', fontSize: '12px' }}>
                    <CheckCircle2 size={24} color="#10b981" style={{ margin: '0 auto 8px', display: 'block' }} />
                    No notifications right now
                  </div>
                ) : (
                  dynamicNotifications.map((n) => (
                    <div 
                      key={n.id} 
                      className={`notif-item ${n.unread ? 'unread' : ''}`}
                      onClick={() => handleNotificationClick(n)}
                      title={n.targetPage ? `Click to open ${n.targetPage}` : ''}
                      style={{ cursor: 'pointer', backgroundColor: n.isPendingAccess && n.unread ? '#fffbeb' : undefined }}
                    >
                      <div className="notif-item-title" style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: '6px' }}>
                        <div style={{ display: 'flex', alignItems: 'center', gap: '6px', minWidth: 0 }}>
                          {n.unread && (
                            <span 
                              className="status-dot" 
                              style={{ 
                                width: 7, 
                                height: 7, 
                                backgroundColor: n.tagBg === '#fef3c7' ? '#f59e0b' : 'var(--digi-green)', 
                                display: 'inline-block', 
                                borderRadius: '50%', 
                                flexShrink: 0 
                              }}
                            />
                          )}
                          <span style={{ fontWeight: 700, fontSize: '12.5px', color: '#0f172a', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>
                            {n.title}
                          </span>
                        </div>
                        {n.tag && (
                          <span style={{ 
                            fontSize: '9.5px', 
                            fontWeight: 700,
                            padding: '1px 6px', 
                            borderRadius: '4px', 
                            backgroundColor: n.tagBg || '#f1f5f9', 
                            color: n.tagColor || '#475569',
                            whiteSpace: 'nowrap',
                            flexShrink: 0
                          }}>
                            {n.tag}
                          </span>
                        )}
                      </div>
                      <div className="notif-item-desc" style={{ fontSize: '11.5px', color: '#475569', marginTop: '3px' }}>
                        {n.message}
                      </div>
                      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginTop: '5px' }}>
                        <div className="notif-item-time" style={{ fontSize: '10px', color: '#94a3b8' }}>
                          {n.time}
                        </div>
                        {n.targetPage && (
                          <span style={{ fontSize: '10.5px', color: '#0284c7', fontWeight: 600, display: 'flex', alignItems: 'center', gap: '3px' }}>
                            Open {n.targetPage} →
                          </span>
                        )}
                      </div>
                    </div>
                  ))
                )}
              </div>
            </div>
          )}
        </div>

        {/* User Profile Area */}
        <div style={{ position: 'relative' }} ref={profileContainerRef}>
          <div 
            className="user-menu-btn" 
            onClick={() => setShowProfilePopover(!showProfilePopover)}
            title="User Profile & Account"
          >
            <div className="user-menu-avatar" style={{ background: (currentUser?.role === 'admin') ? 'var(--grad-primary)' : '#16202c', color: (currentUser?.role === 'admin') ? '#04261b' : '#34d399' }}>
              {currentUser?.avatarInitials || userInitials}
            </div>
            <span className="user-menu-name">{currentUser?.name || USER_PROFILE.name}</span>
            <ChevronDown size={14} color="#64748b" />
          </div>

          {showProfilePopover && (
            <div className="profile-mini-popover">
              <div className="profile-popover-header">
                <div className="profile-popover-avatar" style={{ background: (currentUser?.role === 'admin') ? 'var(--grad-primary)' : '#16202c', color: (currentUser?.role === 'admin') ? '#04261b' : '#34d399' }}>
                  {currentUser?.avatarInitials || userInitials}
                </div>
                <div>
                  <div className="profile-popover-name">{currentUser?.name || USER_PROFILE.name}</div>
                  <div className="profile-popover-email">{currentUser?.email || USER_PROFILE.email}</div>
                  <div style={{ 
                    fontSize: '10.5px', 
                    color: currentUser?.role === 'admin' ? '#00cc00' : '#3b82f6', 
                    fontWeight: 700, 
                    marginTop: '2px' 
                  }}>
                    {currentUser?.role === 'admin' ? '👑 Admin (Full Access)' : '👤 Employee (Tracking)'}
                  </div>
                </div>
              </div>
              <div className="profile-popover-divider" />
              <div className="profile-popover-item">
                <span className="popover-meta-label">Workspace:</span>
                <span className="popover-meta-val">{USER_PROFILE.workspace}</span>
              </div>
              <div className="profile-popover-item">
                <span className="popover-meta-label">Status:</span>
                <span className="popover-meta-val" style={{ color: '#00cc00', display: 'flex', alignItems: 'center', gap: 4 }}>
                  <span className="status-dot" style={{ width: 6, height: 6, backgroundColor: '#00cc00' }}></span> Online
                </span>
              </div>
              <div className="profile-popover-divider" />
              {onLogout && (
                <button
                  type="button"
                  className="profile-popover-logout-btn"
                  onClick={() => {
                    setShowProfilePopover(false);
                    onLogout();
                  }}
                >
                  <LogOut size={14} />
                  <span>Log Out of Workspace</span>
                </button>
              )}
            </div>
          )}
        </div>
      </div>
    </header>
  );
}